#include <winver.h>

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,1,6,0
PRODUCTVERSION 2,1,6,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Green Hat Kid"
            VALUE "FileDescription", "Green Hat Kid Keyboard & Mouse Plus"
            VALUE "FileVersion", "2.1.6.0"
            VALUE "InternalName", "GreenHatKid-KBM-Plus"
            VALUE "LegalCopyright", "Copyright (c) 2026 DWLKS. MIT License. Based on lichii-keyboard-mouse by exgde/joaobyss (MIT)."
            VALUE "OriginalFilename", "GreenHatKid-KBM-Plus.exe"
            VALUE "ProductName", "Green Hat Kid Keyboard & Mouse Plus"
            VALUE "ProductVersion", "2.1.6.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
